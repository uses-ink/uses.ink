// Spike stubs of `ink:host` (architecture.md section 6). Only what the spike calls.
package ink:host@0.1.0;

interface pen {
  record point { x: f64, y: f64 }

  /// One quick pencil line from `start` to `end` (`from` is a WIT keyword), seeded by `seed`, as SVG path data.
  stroke: func(start: point, end: point, weight: f64, seed: string) -> string;
}

interface text {
  record extent { width: f64, height: f64 }

  /// The box `text` takes in `font` at `size` pixels.
  measure: func(font: string, size: f64, text: string) -> extent;
}
