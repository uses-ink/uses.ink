package ink:model@0.1.0;

/// One file as a format read it (`model::Read`): its body, the frontmatter keys the engine
/// reads, each with where it is written, and what the format found worth saying.
interface read {
    use diagnostic.{span, diagnostic, notice};
    use document.{document, slug};
    use site.{when, language, tag, page-kind};

    record front {
        title: option<tuple<string, span>>,
        /// `none` inside is `date: false`, a decided none.
        date: option<tuple<option<when>, span>>,
        updated: option<tuple<option<when>, span>>,
        slug: option<tuple<slug, span>>,
        tags: option<tuple<list<tag>, span>>,
        publish: option<tuple<bool, span>>,
        draft: option<tuple<bool, span>>,
        kind: option<tuple<page-kind, span>>,
        description: option<tuple<option<string>, span>>,
        language: option<tuple<language, span>>,
        /// Other names a link may use for the page.
        aliases: option<tuple<list<string>, span>>,
        /// Where the frontmatter block is.
        block: option<span>,
    }

    record read {
        document: document,
        front: front,
        /// The first level-1 heading's text and where it is.
        heading: option<tuple<string, span>>,
        /// The tags written in the text, in the order written, each where it is.
        inline-tags: list<tuple<tag, span>>,
        diagnostics: list<diagnostic>,
        notices: list<notice>,
    }
}
