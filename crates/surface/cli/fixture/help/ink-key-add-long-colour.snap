---
source: crates/standalone/fixture/src/lib.rs
---
Make a key for another machine, such as a CI job.

\e[1mUsage\e[0m: \e[1m\e[36mink\e[0m \e[1m\e[36mkey\e[0m \e[1m\e[36madd\e[0m \e[36m[OPTIONS]\e[0m

\e[1mExamples\e[0m
  \e[2m# \e[0mA deploy key for one site, written to a file
  \e[1m\e[36mink\e[0m \e[1m\e[36mkey\e[0m \e[1m\e[36madd\e[0m \e[1m\e[36m--site\e[0m 0123456789abcdef0123456789abcdef \e[1m\e[36m--label\e[0m ci \e[1m\e[36m--out\e[0m ci.key

\e[1mOptions\e[0m
  \e[1m\e[36m    --site\e[0m \e[36m<ID>\e[0m       A site's id: make a deploy key for that one site.
                        Without it, a device key
  \e[1m\e[36m    --label\e[0m \e[36m<TEXT>\e[0m    What the person sees beside the fingerprint
                        \e[2m[default: ci]\e[0m
  \e[1m\e[36m    --right\e[0m \e[36m<LIST>\e[0m    The rights to give, such as `\e[1m\e[36mread,deploy\e[0m`.
                        \e[2m[default: what the kind has by default]\e[0m
  \e[1m\e[36m    --expires\e[0m \e[36m<TTL>\e[0m   How long the key lives, such as `\e[1m\e[36m90d\e[0m`.
                        \e[2m[default: the server's, per kind]\e[0m
  \e[1m\e[36m    --out\e[0m \e[36m<FILE>\e[0m      Write the private key to this file (0600) instead of
                        printing it
  \e[1m\e[36m    --wait\e[0m \e[36m<SECONDS>\e[0m  Seconds to wait for a person to approve the key
                        \e[2m[default: 600]\e[0m
  \e[1m\e[36m    --poll\e[0m \e[36m<SECONDS>\e[0m  Seconds between asks whether it was approved
                        \e[2m[default: 2]\e[0m

\e[1mAccount\e[0m
  \e[1m\e[36m    --api\e[0m \e[36m<URL>\e[0m          The API's address, `\e[1m\e[36mhttp://host[:port]\e[0m`;
                           `\e[1m\e[36maccount.api\e[0m` in the config file \e[2m[env: INK_API]\e[0m
  \e[1m\e[36m    --timeout\e[0m \e[36m<SECONDS>\e[0m  Seconds one call may take \e[2m[default: 30]\e[0m
                           \e[2m[env: INK_TIMEOUT]\e[0m

\e[1mNotes\e[0m
  A person approves the new key, as with login. Its private key is written to
  --out, or printed once to a pipe, never to a terminal.

\e[1mExit codes\e[0m
  0  Done
  2  Wrong usage: no API named, a key that is none, a private key that would
     print to a terminal
  3  No key, or the API refused the signature, or nobody approved the key in
     time
  4  The API could not be reached or failed; safe to retry

\e[1mEnvironment\e[0m
  \e[1m\e[36mINK_API\e[0m       The address of the API, as --api
  \e[1m\e[36mINK_SITE\e[0m      The site's id, as --site
  \e[1m\e[36mINK_KEY\e[0m       The private key to sign requests with, for a CI job; never a
                flag, so it stays out of process lists. `\e[1m\e[36mink\e[0m \e[1m\e[36mlogin\e[0m` keeps one in
                the config folder instead
  \e[1m\e[36mINK_KEY_FILE\e[0m  A file that holds that key, in place of INK_KEY

\e[2mDocs\e[0m    \e[34mhttps://github.com/uses-ink/uses.ink/blob/main/docs/cli.md\e[0m
\e[2mGlobal\e[0m  \e[1m\e[36m-C,\e[0m \e[1m\e[36m--json,\e[0m \e[1m\e[36m-q,\e[0m \e[1m\e[36m-v,\e[0m \e[1m\e[36m--color,\e[0m \e[1m\e[36m--no-progress,\e[0m \e[1m\e[36m--log,\e[0m \e[1m\e[36m--log-file\e[0m
        \e[2m(see `ink --help`)\e[0m
