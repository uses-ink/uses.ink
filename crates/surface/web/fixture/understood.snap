<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light"><title>What we understood - uses.ink</title><style>*,::before,::after{box-sizing:border-box}body{margin:0;background:#ffffff;color:#000000;font-family:"Gaegu",system-ui,sans-serif;font-size:1.25rem;line-height:1.5}a{color:#000000;text-decoration-thickness:2px;text-underline-offset:3px}a:hover{background:#ffff00}code,pre,kbd,.look-path{font-family:"Monaspace Radon",ui-monospace,monospace;font-size:0.85em}pre{margin:0;overflow-x:auto}h1,h2,h3{line-height:1.15;margin:0;font-weight:700}h1{font-size:2.4rem}h2{font-size:1.7rem;margin:2.5rem 0 0.75rem}h3{font-size:1.3rem;margin:1.5rem 0 0.5rem}p{margin:0.5rem 0;max-width:60ch}:focus-visible{outline:3px solid #000000;outline-offset:3px;background:#ffff00}.look-skip{position:absolute;left:0.5rem;top:-4rem;padding:0.5rem 1rem;background:#ffff00;border:3px solid #000000}.look-skip:focus{top:0.5rem}.look-page{max-width:62rem;margin:0 auto;padding:1rem 1rem 5rem}.look-head{display:flex;flex-wrap:wrap;gap:0.5rem 1.5rem;align-items:center;justify-content:space-between;padding-bottom:0.75rem}.look-brand{font-size:1.6rem;font-weight:700;text-decoration:none;color:#e8170b}.look-brand:hover{background:transparent;text-decoration:underline}.look-nav{display:flex;flex-wrap:wrap;gap:0.25rem 1rem;margin:0;padding:0;list-style:none}.look-nav a{display:inline-block;padding:0.25rem 0.5rem;text-decoration:none;border:3px solid transparent}.look-nav a[aria-current]{border-color:#000000;background:#80ffff}.look-who{color:#5c5c5c;font-size:1.1rem}.look-rule{display:block;width:100%;height:14px;margin:0.25rem 0 1.5rem;overflow:visible}.look-rule path{fill:#000000}.look-rule.look-red path{fill:#e8170b}.look-lede{color:#5c5c5c}.look-line{display:flex;flex-wrap:wrap;align-items:baseline;gap:0.25rem 0.75rem;margin:0.25rem 0}.look-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(17rem,1fr));gap:1rem 1.5rem;margin:1rem 0}.look-card{border:3px solid #000000;padding:0.75rem 1rem;background:#ffffff}.look-card h2,.look-card h3{margin-top:0}.look-fill-sky{background:#80ffff}.look-fill-mint{background:#80ff80}.look-fill-pink{background:#ff9ad5}.look-fill-cloud{background:#e6e6e6}.look-fill-bucket{background:#ffff00}.look-state{display:inline-block;padding:0 0.6rem;border:3px solid #000000;font-weight:700}.look-state.look-live{background:#80ff80}.look-state.look-paused{background:#ffff00}.look-state.look-none{background:#e6e6e6}.look-state.look-bad{background:#ff9ad5}.look-state.look-run{background:#80ffff}.look-glyph{font-weight:700;margin-right:0.35rem}.look-button,button{font:inherit;font-weight:700;color:#000000;background:#ffffff;border:3px solid #000000;padding:0.25rem 1rem;cursor:pointer;text-decoration:none;display:inline-block}.look-button.look-main,button.look-main{background:#ffff00;box-shadow:5px 4px 0 #000000}.look-button.look-danger,button.look-danger{background:#ff9ad5}.look-button:hover,button:hover{background:#ffff00}.look-stack{display:grid;gap:0.75rem;max-width:34rem;margin:0.75rem 0}label{font-weight:700;display:block}input[type="text"],input[type="search"],select,textarea{font:inherit;width:100%;padding:0.25rem 0.5rem;border:3px solid #000000;background:#ffffff;color:#000000}.look-hint{color:#5c5c5c;font-size:1.05rem;margin:0.125rem 0 0}.look-table{width:100%;overflow-x:auto;margin:0.5rem 0 1rem}table{border-collapse:collapse;width:100%;min-width:34rem}caption{text-align:left;font-weight:700;font-size:1.3rem;padding:0.5rem 0}th,td{text-align:left;vertical-align:top;padding:0.35rem 0.6rem;border-bottom:2px solid #000000}th{background:#e6e6e6}tr.look-check td{background:#ffff00}details{border:3px solid #000000;padding:0.25rem 0.75rem;margin:0.5rem 0}details[open]{background:#e6e6e6}summary{cursor:pointer;font-weight:700;padding:0.125rem 0}.look-ladder{margin:0.5rem 0;padding-left:1.5rem}.look-ladder li{margin:0.25rem 0}.look-chosen{background:#80ff80;padding:0 0.25rem}.look-note{color:#e8170b;font-weight:700;margin:0.5rem 0}.look-empty{border:3px dashed #000000;padding:1rem;margin:1rem 0;max-width:40rem}.look-empty h2{margin-top:0}.look-failure{border:3px solid #e8170b;padding:0.75rem 1rem;margin:1rem 0;max-width:46rem}.look-failure h2{margin:0 0 0.5rem;color:#e8170b}.look-failure dl{display:grid;grid-template-columns:max-content 1fr;gap:0.25rem 1rem;margin:0.5rem 0 0}.look-failure dt{font-weight:700}.look-failure dd{margin:0}.look-failure ol{margin:0;padding-left:1.25rem}.look-banner{border:3px solid #000000;background:#ffff00;padding:0.5rem 1rem;margin:1rem 0}.look-log{background:#ffffff;border:3px solid #000000;padding:0.5rem 0.75rem;margin:1rem 0;overflow-x:auto}.look-log div{white-space:pre-wrap;overflow-wrap:anywhere}.look-log .look-bad{color:#e8170b;font-weight:700}.look-danger-zone{border:3px solid #e8170b;padding:0.5rem 1rem;margin-top:2rem}.look-meta{color:#5c5c5c}.look-stamp{font-variant-numeric:tabular-nums}@media (max-width:40rem){body{font-size:1.15rem}h1{font-size:2rem}.look-failure dl{grid-template-columns:1fr}.look-button.look-main,button.look-main{box-shadow:4px 3px 0 #000000}}@media (prefers-reduced-motion:no-preference){.look-state.look-run{animation:look-pulse 1.6s ease-in-out infinite}@keyframes look-pulse{0%{opacity:1}50%{opacity:0.6}100%{opacity:1}}}</style></head><body><a class="look-skip" href="#main">Skip to the page</a><div class="look-page"><header class="look-head"><a class="look-brand" href="/">uses.ink</a><nav aria-label="Screens"><ul class="look-nav"><li><a href="/ada-notes">Site</a></li><li><a href="/ada-notes/understood" aria-current="page">What we understood</a></li><li><a href="/ada-notes/deploys">Deploys</a></li><li><a href="/ada-notes/settings">Settings</a></li><li><a href="/account">Account</a></li></ul></nav></header><main id="main"><h1>What we understood</h1><svg class="look-rule" viewBox="0 0 600 14" preserveAspectRatio="none" aria-hidden="