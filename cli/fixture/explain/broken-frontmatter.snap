the site
  site.root          the top of the snapshot  by default
  site.layout        flat                     by default
index.md
  file.ignore        kept                     by default
odd.md
  file.ignore        kept                     by default
index.md
  page.publish       published                by default
  page.kind          a page                   by default
  page.title         “Broken”                 from the heading of index.md, bytes 0..8
  page.date          undated                  by default
  page.updated       never updated            by default
  page.slug          `index`                  from the name of index.md
  page.tags          no tags                  by default
  page.summary       “One page has frontmatter that does not parse: that one.” from the text of index.md
odd.md
  page.publish       published                by default
  page.kind          a page                   by default
  page.title         “Odd”                    from the heading of odd.md, bytes 25..30
  page.date          undated                  by default
  page.updated       never updated            by default
  page.slug          `odd`                    from the name of odd.md
  page.tags          no tags                  by default
